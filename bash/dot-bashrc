# ~/.bashrc

# ---------
#  options
# ---------

# autocd: dirnames as cd commands.
# cdspell: spelling mistakes.
# histappend: append to the history file.
# checkwinsize: update the values of LINES and COLUMNS.
# globstar: ** matches files on subdirectories
shopt -s autocd cdspell histappend checkwinsize globstar

bind 'Control-q: "\C-a\C-k\C-d"'
bind '"\eh": backward-kill-word'
bind '"\e\t": menu-complete'
bind '"\e\e[Z": menu-complete-backward'

stty -ixon

# -------------
#  Environment
# -------------

unset MAIL MAILCHECK
export HISTFILESIZE=2000

export PROGRAMS=$HOME/Programs

export CONAN_HOME=$HOME/.local/share/conan2
export COPILOT_HOME=$HOME/.local/share/copilot
export GRADLE_USER_HOME=$HOME/.local/share/gradle

export VISUAL=vim
export EDITOR=vim
export SUDO_EDITOR=vim

export LESS='--ignore-case --incsearch --mouse --use-color --RAW-CONTROL-CHARS'
export MANPAGER="sh -c 'awk '\''{ gsub(/\x1B\[[0-9;]*m/, \"\", \$0); gsub(/.\x08/, \"\", \$0); print }'\'' | bat --style=plain --paging=always --language=man'"

export PIP_REQUIRE_VENV=1
export VIRTUAL_ENV_DISABLE_PROMPT=1
export LIBVIRT_DEFAULT_URI='qemu:///system'

export DEBEMAIL="lucasllort@gmail.com"
export DEBFULLNAME="Lucas Llort"

export BAT_THEME=OneHalfDark

# -------------
#  Completions
# -------------

. /usr/share/bash-completion/bash_completion

for completion in "$HOME/.local/share/bash-completion/completions/"*; do
    [[ -r "$completion" ]] && source "$completion"
done

# ---------
#  Aliases
# ---------

alias mna='man'
alias atp='apt'
alias suod='sudo'
alias cd..='cd ..'

alias ls='ls --color=auto --hyperlink=auto --classify=auto'
alias sl='ls'
alias l='ls'
alias ll='ls -l --human-readable'
alias la='ls --almost-all'
alias lal='ll --almost-all'
alias lla='lal'


alias v='vi'
alias cim='vim'
alias ncim='nvim'
alias nivm='nvim'

alias shimbolic='ln --symbolic /dev/shm .'
alias virsh='virsh -c qemu:///system'

if [[ $TERM == 'xterm-kitty' ]]; then 
    alias clear="printf '\e[H\e[22J'"
    bind -x '"\C-l":echo; clear'
fi

# -----------
#  Functions
# -----------

function just {
    "$@" &>/dev/null &
    disown '%%';
}

alias _unsetfunc='unset -f "${FUNCNAME[0]}"'

function idfexport {
    export IDF_TOOLS_PATH=$PROGRAMS/esp-idf
    source "$HOME/Repos/esp-idf/export.sh"
    _unsetfunc
}

function gcloudexport {
    source '/home/lucas/Programs/google-cloud-sdk/path.bash.inc'
    source '/home/lucas/Programs/google-cloud-sdk/completion.bash.inc'
    complete -C terraform terraform
    _unsetfunc
}

function sdkexport {
    export SDKMAN_DIR=$HOME/.local/share/sdkman
    source "$SDKMAN_DIR/bin/sdkman-init.sh"
    _unsetfunc
}

function androidexport {
    type sdkexport &>/dev/null && sdkexport

    # this next thing is weird but it's for backwards compatibility
    export ANDROID_SDK_HOME=$HOME/.local/share/android 
    export ANDROID_USER_HOME=$ANDROID_SDK_HOME/.android
    export ANDROID_HOME=$PROGRAMS/android_sdk
    PATH=$ANDROID_HOME/platform-tools:$PATH
    PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$PATH

    alias gradlew='./gradlew'
    _unsetfunc
}

function envexport {
    local env_filename=$1
    if [[ -z "$env_filename" ]]; then
        env_filename=".env"
    fi

    local env_path=$(back-search -f "$env_filename")

    if [[ ! -z $env_path ]]; then
        set -o allexport
        source "$env_path"
        set +o allexport
        cat "$env_path"
        return 0
    fi

    echo "File \"$env_filename\" not found."
    return 1
}

function projexport {
    local proj_filename=$1
    if [[ -z "$proj_filename" ]]; then
        proj_filename=".proj"
    fi

    local proj_path=$(back-search -f "$proj_filename")

    if [[ ! -z $proj_path ]]; then
        source "$proj_path"
        return 0
    fi

    echo "File \"$proj_filename\" not found."
    return 1
}

function pyexport {
    if [[ -v VIRTUAL_ENV ]]; then
        echo "Enviroment variable VIRTUAL_ENV is set, deactivate the current virtual environment."
        return 1
    fi

    if [[ -z $1 ]]; then
        local dot_path=$(back-search -d ".venv/bin")
        local simple_path=$(back-search -d "venv/bin")

        if [[ ${#dot_path} -gt ${#simple_path} ]]; then
            local script_path=$dot_path
        else
            local script_path=$simple_path
        fi

    else 
        local script_path=$(back-search -d "$1/bin")
    fi

    if [[ -z $script_path ]]; then
        echo "Virtual environment not found."
        return 1
    fi

    source "$script_path/activate"
    echo "VIRTUAL_ENV=$(abs_to_rel_path "$VIRTUAL_ENV")"

    if [[ -x $script_path/pip ]]; then 
        eval "$("$script_path/pip" completion --bash)"
    elif [[ -x $(command -v uv) ]]; then
        eval "$(uv generate-shell-completion bash)"
    fi

    return 0
}

function back-search {
    local current_dir=$PWD

    while [[ -n "$current_dir" ]]; do
        local found_path=$current_dir/$2 

        if test "$1" "$found_path"; then
            echo "$found_path"
            return 0
        fi

        current_dir=${current_dir%/*}
    done

    return 1
}

function abs_to_rel_path {
    local res=${1#"$PWD"}
    if [[ $res != "$1" ]]; then
        echo ".$res"
        return
    fi

    local prev_dir=${PWD%/*}
    res=${1#"$prev_dir"}
    if [[ $res != "$1" ]]; then
        echo "..$res"
        return
    fi

    res=${1#"$HOME"}
    if [[ $res != "$1" ]]; then
        echo "~$res"
        return
    fi
}

# --------
#  Prompt
# --------

esc=$'\e'
bel=$'\a'
csi=$esc'['
osc=$esc']'

reset=$csi'0m'
dark_white=$csi'37m'
bright_black=$csi'90m'
bright_red=$csi'91m'
bright_blue=$csi'94m'
bright_magenta=$csi'95m'
bright_cyan=$csi'96m'
bright_white=$csi'97m'

logo_col=$bright_red
host_col=$bright_blue
dir_col=$bright_magenta
git_col=$bright_cyan
exit_col=$bright_red
prompt_col=$bright_white
no_col=$reset

prompt_icon='$'
dir_sep='...'

git_branch='(b:'
git_tag='(t:'
git_commit='(c:'
git_end=')'

exit_icon='(e:'
exit_end=')'

if [[ $COLORTERM == "truecolor" ]]; then
    logo_icon=' '
    prompt_icon=''
    dir_sep='....'

    git_branch=''
    git_tag=''
    git_commit=''
    git_end=''

    exit_icon=''
    exit_end=''

    ps1_start=$osc'133;A'$bel
    ps1_end=$osc'133;B'$bel

    ps2_start=$osc'133;A;k=s'$bel
    ps2_end=$osc'133;B;k=s'$bel

    cmd_start=$osc'133;C'$bel
    cmd_end=$osc'133;D;$?'$bel
fi

function update_pwd_signal {
    pwd_pretty=$PWD
    if [[ $pwd_pretty != '/' ]]; then
        pwd_pretty=${pwd_pretty/#$HOME/'~'}
        pwd_pretty=${pwd_pretty#/}
        pwd_pretty=${pwd_pretty/\/*\//\/$dir_sep\/}
    fi

    pwd_signal=$osc"0;$pwd_pretty$bel"
}
update_pwd_signal

function cd {
    builtin cd "$@" || return
    local uri="file://$HOSTNAME$PWD"
    echo -nE $osc"7;$uri$bel"

    update_pwd_signal
    git_status_update_pending=1
}

alias git='git_status_update_pending=1; git'
alias lazygit='git_status_update_pending=1; lazygit'

exit_status=''
git_status=''
git_status_update_pending=1; 

function update_git_status {
    # if on a branch
    git_status=$(git symbolic-ref --short HEAD 2>/dev/null)
    if [[ -n $git_status ]]; then
        git_status="$git_branch $git_status$git_end "
        return
    fi

    # if on a tag
    git_status=$(git describe --tags --exact-match 2>/dev/null)
    if [[ -n $git_status ]]; then
        git_status="$git_tag $git_status$git_end "
        return
    fi

    # else use commit hash
    git_status="$git_commit $(git rev-parse --short HEAD 2>/dev/null)$git_end "
}

function update_prompt {
    exit_status=$?
    if [[ $exit_status == 0 ]]; then
        exit_status=''
    else
        exit_status="$exit_icon $exit_status$exit_end "
    fi

    if [[ -n "$git_status_update_pending" ]]; then
        git_status_update_pending=''
        git_status=''
        back-search -d .git &>/dev/null && update_git_status
    fi
}

PROMPT_COMMAND=update_prompt
PS0="\[$cmd_start\]"
PS1="\
\[$cmd_end\$pwd_signal$ps1_start$no_col$logo_col\]$logo_icon\
\[$host_col\]\\u@\\H \
\[$dir_col\]\$pwd_pretty \
\[$git_col\]\$git_status\
\[$exit_col\]\$exit_status\
\[$prompt_col\]$prompt_icon \
\[$no_col$ps1_end\]"

PS2="\
\[$ps2_start\]\
\[$prompt_col\]$prompt_icon \
\[$no_col$ps2_end\]"

function set_cmd_to_win_title {
    [[ $BASH_COMMAND != update_prompt ]] && echo -nE $osc"0;$BASH_COMMAND$bel"
}
trap set_cmd_to_win_title DEBUG

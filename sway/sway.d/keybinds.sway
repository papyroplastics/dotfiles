# Programs
bindsym {
    $mod+t exec kitty --single-instance
    $mod+d exec wofi
    $mod+ctrl+d exec rofi -show
    $mod+shift+d exec rofi -drun-reload-desktop-cache -show

    $mod+e exec nemo
    $mod+v exec pavucontrol
    $mod+n exec blueman-manager

    $mod+b exec flatpak run org.mozilla.firefox
    $mod+m exec flatpak run org.mozilla.thunderbird_esr

    Print exec grimshot --notify save active
    Shift+Print exec grimshot save area
}

# Volume
set $volume_cmd wpctl set-volume @DEFAULT_SINK@
set $mute_cmd   wpctl set-mute   @DEFAULT_SINK@
bindsym {
    XF86AudioRaiseVolume  exec $volume_cmd 1%+
    $mod+F8               exec $volume_cmd 1%+
                          
    XF86AudioLowerVolume  exec $volume_cmd 1%-
    $mod+F7               exec $volume_cmd 1%-
                          
    XF86AudioMute         exec $mute_cmd toggle
    $mod+F6               exec $mute_cmd toggle
}

# Brightness
set $bright_cmd brightnessctl set 
bindsym {
    XF86MonBrightnessUp   exec $bright_cmd +1%
    $mod+F3               exec $bright_cmd +1%

    XF86MonBrightnessDown exec $bright_cmd 1%-
    $mod+F2               exec $bright_cmd 1%-
}

# Nagbar
bindsym $mod+Escape exec swaynag -t warning -m 'Perform an action' \
    -Z 'Reload' 'swaymsg reload' \
    -Z 'Exit' 'swaymsg exit' \
    -Z 'Reboot' '/usr/sbin/shutdown --reboot now' \
    -Z 'Poweroff' '/usr/sbin/shutdown --poweroff now' \


# Options
font pango:DroidSansM Nerd Font Bold 11
titlebar_padding 1
title_align center
default_border none 
default_floating_border none 
hide_edge_borders --i3 none

seat * xcursor_theme Bibata-Modern-Classic 24

# Background
set $background ../assets/background.jpg
output * bg $background fill

# Colors
set $text     #cdd6f4
set $subtext1 #bac2de
set $subtext0 #a6adc8

set $base     #1e1e2e
set $mantle   #181825
set $crust    #11111b

set $red      #e78284
set $surface2 #585b70

client.focused          $base   $base   $text     $base   $base
client.focused_inactive $mantle $mantle $subtext1 $mantle $mantle
client.unfocused        $crust  $crust  $subtext0 $crust  $crust 
client.urgent           $red    $red    $text     $red    $red

bar {
    status_command i3status
    mode hide
    hidden_state hide
    font pango:DroidSansM Nerd Font 11
    separator_symbol " ❯ "
    colors {
        background $base
        statusline $text
        separator  $surface2

        focused_workspace  $crust $crust $text
        active_workspace   $crust $crust $text
        inactive_workspace $base  $base  $subtext0
        urgent_workspace   $red   $red   $text
    }
}



# Options
font monospace 0.1
titlebar_padding 1
default_border none 
default_floating_border none 
hide_edge_borders --i3 none

seat * xcursor_theme Bibata-Modern-Classic 24

# Background
set $background ../$assets_dir/background.jpg
output * bg $background fill

# Screensaver
set $command_lock swaylock \
    --daemonize --ignore-empty-passwor \
    --indicator-radius 120 --indicator-thickness 6 \
    --image $(~/.config/sway/$assets_dir/screenblur.sh) --scaling fill

set $command_screen_off swaymsg "output * dpms off"
set $command_screen_on  swaymsg "output * dpms on"

exec swayidle -w \
    timeout 600 '$command_screen_off' resume '$command_screen_on' \
    timeout 900 '$command_lock' \
    before-sleep '$command_lock'

# Colors
set $acbg #44475A
set $acfg #F8F8F2
set $inbg #282A36
set $infg #BFBFBF
set $urbg #FF5555

# Color classes         brdr   bg   text   ind  ch_brdr
client.focused          $acbg $acbg $acbg $acbg $acbg
client.focused_inactive $acbg $acbg $acbg $acbg $acbg
client.unfocused        $inbg $inbg $inbg $inbg $inbg
client.urgent           $urbg $urbg $urbg $urbg $urbg

bar {
    status_command i3status
    mode hide
    hidden_state hide
    font pango:DroidSansM Nerd Font 11
    separator_symbol " ❯ "
    colors {
        background $inbg
        statusline $acfg
        separator #585B70

        # Class            brdr  bg  text
        focused_workspace  $acbg $acbg $acfg
        active_workspace   $inbg $acbg $acfg
        inactive_workspace $inbg $inbg $infg
        urgent_workspace   $urbg $urbg $acfg
        binding_mode       $urbg $urbg $acfg
    }
}


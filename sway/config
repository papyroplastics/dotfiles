
# Global variables
set $mod Mod4
set $assets_dir assets

# Session setup
xwayland enable

set $env_vars \
    WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
    DISPLAY XAUTHORITY XCURSOR_SIZE XCURSOR_THEME QT_QPA_PLATFORMTHEME

exec {
    dbus-update-activation-environment --systemd $env_vars
    systemctl --user import-environment $env_vars
    mate-polkit
}

# Lock screen
set $command_lock swaylock \
    --daemonize --ignore-empty-passwor \
    --indicator-radius 120 --indicator-thickness 6 \
    --image $(~/.config/sway/$assets_dir/screenblur.sh) --scaling fill

set $command_screen_off swaymsg "output * dpms off"
set $command_screen_on  swaymsg "output * dpms on"

exec swayidle -w \
    timeout 600 '$command_screen_off' resume '$command_screen_on' \
    timeout 900 '$command_lock' \
    before-sleep '$command_lock' \
    lock '$command_lock' \
    idlehint 1200


# Include configs
include sway.d/*.sway
